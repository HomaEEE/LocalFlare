{
  "name": "localflare",
  "displayName": "LocalFlare",
  "description": "Expose Herd, Valet, MAMP and other local domains through Cloudflare Tunnel.",
  "version": "0.1.0",
  "publisher": "localflare",
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:localflare.scanDomains",
    "onCommand:localflare.startQuickTunnel",
    "onCommand:localflare.loginCloudflare",
    "onCommand:localflare.startNamedTunnel",
    "onView:localflare.domains"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "localflare.scanDomains", "title": "LocalFlare: Scan Local Domains" },
      { "command": "localflare.startQuickTunnel", "title": "LocalFlare: Start Free Quick Tunnel" },
      { "command": "localflare.loginCloudflare", "title": "LocalFlare: Login to Cloudflare" },
      { "command": "localflare.startNamedTunnel", "title": "LocalFlare: Start Custom Domain Tunnel" },
      { "command": "localflare.stopTunnel", "title": "LocalFlare: Stop Active Tunnel" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "localflare", "title": "LocalFlare", "icon": "resources/localflare.svg" }
      ]
    },
    "views": {
      "localflare": [
        { "id": "localflare.domains", "name": "Local Domains" }
      ]
    },
    "configuration": {
      "title": "LocalFlare",
      "properties": {
        "localflare.extraDomains": {
          "type": "array",
          "default": [],
          "items": { "type": "string" },
          "description": "Additional local domains or origin URLs to offer for tunneling."
        },
        "localflare.defaultOriginPort": {
          "type": "number",
          "default": 80,
          "description": "Fallback HTTP port when a discovered domain does not include a port."
        },
        "localflare.cloudflaredPath": {
          "type": "string",
          "default": "cloudflared",
          "description": "Path to the cloudflared executable."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.89.0",
    "typescript": "^5.4.5"
  }
}
